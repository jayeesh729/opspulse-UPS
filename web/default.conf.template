# OpsPulse web - serves the built Vite SPA and proxies /api to the api container.
# Installed as /etc/nginx/conf.d/default.conf, replacing the image default.
#
# Why the proxy exists: the React client calls the API at the RELATIVE path /api.
# In dev that is handled by the Vite proxy; there is no Vite in this image, so nginx
# has to do the same job or every request 404s against the static file root.

server {
    listen       8080;
    listen       [::]:8080;
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    # Docker's embedded DNS. Resolving the upstream at request time (via a variable)
    # instead of at startup means nginx boots even if `api` is not up yet, and it
    # picks up a new container IP after `docker compose down && up`.
    # NGINX_LOCAL_RESOLVERS is filled from /etc/resolv.conf by the image entrypoint, so this
    # works under both Docker (127.0.0.11) and Kubernetes (CoreDNS) from one build.
    resolver ${NGINX_LOCAL_RESOLVERS} ipv6=off valid=10s;

    server_tokens off;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # --- API proxy -------------------------------------------------------------
    location /api/ {
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream$request_uri;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        proxy_connect_timeout 5s;
        proxy_read_timeout    120s;   # the /api/explain LLM call is slow
        proxy_send_timeout    120s;
        proxy_buffering off;
    }

    # Bare /api with no trailing slash, for completeness.
    location = /api {
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # --- Static SPA ------------------------------------------------------------
    # Hashed Vite assets can be cached hard; index.html must never be.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # Client-side routing: unknown paths fall back to the SPA shell.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
